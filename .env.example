# Copy to .env for local development; `deno task dev`, `deno task dev:api`
# and `deno task start` all load it. On Deno Deploy set these as the app's
# environment variables (the VITE_* ones are read at build time; Vite only
# exposes VITE_-prefixed values to the browser, so API secrets stay private).

# ----------------------------------------------------------------- web (build)
# Public site origin baked into prerendered meta tags.
VITE_SITE_URL=https://initiatives.thedao.fund
# WalletConnect project id from https://cloud.reown.com (optional; without it
# only injected browser wallets are offered).
VITE_WALLETCONNECT_PROJECT_ID=
# Optional mainnet RPC for balance reads (default: public endpoint).
VITE_RPC_URL=
# Privy app id from https://dashboard.privy.io (optional). Adds "Email" to the
# wallet picker: a one-time code by email, then a Privy embedded wallet that
# signs in with Ethereum like any other. Add the site's origin to the app's
# allowed origins in the dashboard, and keep Email as its only login method.
VITE_PRIVY_APP_ID=
# Only to point the web app at a remote API. Leave unset: the site server
# hosts the API under /api and the dev server proxies it there.
# VITE_API_URL=

# ------------------------------------------------------------------------ api

# Browser origins allowed to call the API (CORS + SIWE `uri`), comma-separated.
# Optional: defaults to VITE_SITE_URL's origin, so a deployment on one domain
# needs nothing here. Set it for local dev (the Vite dev server) or when a
# second custom domain must be accepted.
WEB_ORIGIN=http://localhost:5173
# Hostname suffixes whose own origin is accepted without listing, so every
# *.deno.net production/branch URL of the project just works.
# SELF_HOST_SUFFIXES=.deno.net,.deno.dev
# SIWE `domain` values accepted (defaults to the hosts of WEB_ORIGIN).
# SIWE_DOMAINS=localhost:5173

# Wallets that get an admin session when they sign in (EIP-55 checksummed).
# Defaults to the address in config.ts when unset. These are fixed; more
# admins can be added and removed from the admin dashboard.
# ADMIN_ADDRESSES=0x839395e20bbB182fa440d08F850E6c7A8f6F0780

# The 5 Safe signers (comma-separated, EIP-55 checksummed). Safe deployment
# stays disabled until exactly 5 valid, distinct addresses are set.
OPERATIONAL_SIGNERS=

# Production RPC, prepended to the public fallbacks.
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Safe Transaction Service API key (https://developer.safe.global). Required
# in production: unauthenticated access is capped at 5,000 requests/month.
SAFE_API_KEY=
# Donation-ledger cache lifetime in seconds (default 600, minimum 60).
# Pages show saved rows, then refresh stale data while viewed.
# Replaces the removed SAFE_SYNC_CRON.
# SAFE_SYNC_TTL_SECS=600
# A daily cache refresh runs at 03:00 UTC only when Deno's built-in
# DENO_TIMELINE equals "production". Do not set it locally; branch and preview
# timelines skip scheduled refresh work. Fresh cache entries are reused.
# DISABLE_RATE_LIMITS=true turns off every rate limit (submissions, login, support, uploads); for live sessions where a room shares one IP. Unset it afterwards.
# DISABLE_RATE_LIMITS=

# Alchemy app key (https://dashboard.alchemy.com): adds an Alchemy mainnet RPC
# ahead of the public fallbacks (RPC_URL, if set, still comes first).
# ALCHEMY_API_KEY=

# Pinata (https://app.pinata.cloud) for backer logos and profile pictures.
# Uploads are disabled (503) until the JWT is set.
PINATA_JWT=
# PINATA_GATEWAY=ipfs.blossom.software   # the host that serves /ipfs/<cid>; Blossom's gateway by default

# AI board search + comment moderation (OpenAI-compatible; default DeepSeek).
# Both features stay off until the key is set; without moderation, anonymous
# comments are held for admin review.
AI_SEARCH_API_KEY=
# AI_SEARCH_BASE_URL=https://api.deepseek.com
# AI_SEARCH_MODEL=deepseek-chat
# Cap on tokens per AI reply. Reasoning models spend most of this on hidden
# thinking before emitting the JSON, so keep it generous (it is a ceiling,
# not a target: models that finish early are not billed for the slack).
# AI_SEARCH_MAX_TOKENS=2000
# Sent as OpenAI-style `reasoning_effort` (default "none": a thinking model
# that reasons over the whole board takes 20 s+ and times out). "default"
# omits the field for providers that reject it.
# AI_SEARCH_REASONING_EFFORT=none

# Support widget (the floating "Support" button). Messages are tagged with the
# site, category and page, then POSTed here as {name, email, message, screenshot}
# (Blossom's support inbox, the same contract as Octo). The widget stays off
# (503) until it is set.
# SUPPORT_URL=https://octosupport.blossom.deno.net

# Card on-ramp (transak | moonpay) and WalletConnect passthrough for the frontend.
# ONRAMP_PROVIDER=transak
# ONRAMP_API_KEY=
# WALLETCONNECT_PROJECT_ID=

# Private preview: when both are set the whole site (pages, assets, API) demands
# HTTP Basic Auth once, then keeps the browser in with a cookie. /healthz stays open.
# SITE_USERNAME=
# SITE_PASSWORD=

# Client IP and HTTPS use Deno runtime metadata; forwarding headers are ignored.
# Deployment verification: docs/client-ip-security.md.
# Content-Security-Policy for the site pages. By default only the framing
# directives are enforced and the full policy (script hashes, connect/frame
# sources) is sent as Content-Security-Policy-Report-Only, so violations show
# in the browser console without breaking anything. To promote it: open the
# site, run the wallet flows (connect, donate, admin) and watch the console
# for "Report Only" CSP violations; once none appear, set CSP_ENFORCE=true.
# CSP_ENFORCE=
# PORT=8000
# Local KV file (leave unset on Deno Deploy).
KV_PATH=./.kv
# Optional namespace for every KV key, so several deployments (e.g. preview and
# production) can share one KV database without colliding. Changing it on an
# existing deployment starts from an empty database. Applies to
# `deno task import-sqlite` too.
# DB_PREFIX=

# Dev-only, for `deno task login` / `deno task sync-content`:
# ADMIN_PRIVATE_KEY=0x...
# API_URL=http://localhost:8000
# SITE_USERNAME= / SITE_PASSWORD= are also read by `deno task login` when the
# target site is locked.
