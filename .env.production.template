# Production .env for thedao-rfps.
# Copy to `.env` on the server, fill in the values, then `chmod 600 .env`.
# SECRET_KEY and ADMIN_PASSWORD are auto-generated on first run if left blank,
# but for production set a fresh ADMIN_PASSWORD yourself (the sandbox one has
# been around for weeks).

# --- required for a public deploy ---
SITE_URL=https://rfps.thedao.fund/
COOKIE_SECURE=1
TRUST_PROXY=1
BIND_HOST=127.0.0.1
ADMIN_PASSWORD=change-me-to-something-long-and-unique

# --- the 5 Safe signers (comma-separated, EIP-55 checksummed) ---
# Safe deployment stays disabled until exactly 5 valid, distinct addresses.
OPERATIONAL_SIGNERS=0x...,0x...,0x...,0x...,0x...

# --- production RPC (Alchemy/Infura/dRPC free tier) ---
# Prepended to the public fallbacks; the scanner + verification stop depending
# on flaky public endpoints.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- AI board search (optional; hidden if unset) ---
# DeepSeek is the default provider. Keep the prepaid balance small and DO NOT
# enable auto-recharge. Swap BASE_URL/MODEL for any OpenAI-compatible host.
AI_SEARCH_API_KEY=
AI_SEARCH_BASE_URL=https://api.deepseek.com
AI_SEARCH_MODEL=deepseek-chat

# --- card donations (optional; card tab hidden until a key is set) ---
# See docs/card-donations-research.md. Transak is the direct-to-Safe path.
ONRAMP_PROVIDER=transak
ONRAMP_API_KEY=

# --- optional: override the listen port (default 4482) ---
# PORT=4482
