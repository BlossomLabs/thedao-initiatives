# Production .env for thedao-rfps.
# Copy to `.env` on the server, fill in the values, then `chmod 600 .env`.
# SECRET_KEY and ADMIN_PASSWORD are auto-generated on first run if left blank,
# but for production set a fresh ADMIN_PASSWORD yourself (the sandbox one has
# been around for weeks).

# --- required for a public deploy ---
SITE_URL=https://fund.thedao.fund/
COOKIE_SECURE=1
TRUST_PROXY=1
BIND_HOST=127.0.0.1
ADMIN_PASSWORD=change-me-to-something-long-and-unique

# --- private preview gate ---
# While both are set, the ENTIRE site asks for this username/password before
# showing anything (uptime checks on /healthz still work). To open the site
# to the public later: blank both lines and restart the service.
SITE_USERNAME=thedao
SITE_PASSWORD=change-me-too

# --- the 5 Safe signers (comma-separated, EIP-55 checksummed) ---
# This is the corrected production set (July 2026). Copy-paste, never retype:
# the app refuses to deploy Safes on any checksum mismatch.
OPERATIONAL_SIGNERS=0x839395e20bbB182fa440d08F850E6c7A8f6F0780,0xC46c67Bb7E84490D7EbdD0b8ecDaca68Cf3823F4,0x939E50655cf6dA7D643CFf8Cfa31c3033b16328A,0xb760FE1bbC4A2752aBCBb28291a57Cb0cA99fF44,0x5256d6d94eD14667fa1661a99F5B142B1e051B8e

# --- production RPC (Alchemy/Infura/dRPC free tier) ---
# Prepended to the public fallbacks; the scanner + verification stop depending
# on flaky public endpoints.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- AI board search (optional; hidden if unset) ---
# DeepSeek is the default provider. Keep the prepaid balance small and DO NOT
# enable auto-recharge. Swap BASE_URL/MODEL for any OpenAI-compatible host.
AI_SEARCH_API_KEY=
AI_SEARCH_BASE_URL=https://api.deepseek.com
AI_SEARCH_MODEL=deepseek-chat

# --- WalletConnect (optional; lets mobile / extension-less users connect) ---
# Free project id from https://cloud.reown.com. In the Reown dashboard, add
# this site's domain to the project's Allowlist or the QR modal shows
# "Invalid App Configuration". Left empty = no QR option, no extra CSP hosts.
WALLETCONNECT_PROJECT_ID=

# --- optional: override the listen port (default 4482) ---
# PORT=4482
