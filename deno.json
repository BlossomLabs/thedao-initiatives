{
  "nodeModulesDir": "auto",
  "unstable": ["kv", "cron"],
  "tasks": {
    "dev": { "dependencies": ["dev:api", "dev:web"] },
    "dev:web": "deno run -A npm:@react-router/dev dev",
    "dev:api": "deno run --env-file=.env -A --watch api/main.ts",
    "build": "deno run -A npm:@react-router/dev build",
    "start": "deno run --env-file=.env --allow-net --allow-read --allow-env --allow-write server.ts",
    "typecheck": "deno run -A npm:@react-router/dev typegen && deno run -A npm:typescript/tsc",
    "test": "deno run -A npm:vitest run",
    "test:api": "deno test -A api/",
    "check:api": "deno check api/main.ts server.ts api/scripts/*.ts shared/draft/mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "sync-wallets": "deno run --env-file=.env --allow-env --allow-net=explorer-api.walletconnect.com --allow-write=public/wallets.json scripts/sync-wallets.ts",
    "sync-content": "deno run --env-file=.env -A api/scripts/sync-content.ts",
    "login": "deno run --env-file=.env -A api/scripts/login.ts",
    "bench": "deno run --allow-net api/scripts/bench.ts"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.3",
    "hono": "jsr:@hono/hono@^4.13.8",
    "@std/ulid": "jsr:@std/ulid@^1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns", "deno.unstable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "include": ["app/", "api/", "shared/", "server.ts"],
    "rules": { "tags": ["recommended"], "exclude": ["no-explicit-any"] }
  },
  "fmt": { "include": ["app/", "api/", "shared/", "server.ts", "test/"], "lineWidth": 100, "indentWidth": 2 }
}
