{
  "nodeModulesDir": "auto",
  "unstable": [
    "kv",
    "cron"
  ],
  "tasks": {
    "dev": {
      "dependencies": [
        "dev:api",
        "dev:web"
      ]
    },
    "dev:web": "deno run -A npm:@react-router/dev dev",
    "dev:prod": "API_PROXY=https://initiatives.thedao.fund deno run -A npm:@react-router/dev dev",
    "dev:api": "deno run --env-file=.env -A --watch api/main.ts",
    "build": "deno run -A npm:@react-router/dev build",
    "start": "deno run --env-file=.env --allow-net --allow-read --allow-env --allow-write server.ts",
    "typecheck": "deno run -A npm:@react-router/dev typegen && deno run -A npm:typescript/tsc",
    "test": "deno run -A npm:vitest run",
    "test:api": "deno test -A api/",
    "check:api": "deno check api/main.ts server.ts api/scripts/*.ts shared/draft/mod.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "sync-wallets": "deno run --env-file=.env --allow-env --allow-net=explorer-api.walletconnect.com --allow-write=public/wallets.json scripts/sync-wallets.ts",
    "sync-content": "deno run --env-file=.env -A api/scripts/sync-content.ts",
    "login": "deno run --env-file=.env -A api/scripts/login.ts",
    "seed-categories": "deno run --env-file=.env -A api/scripts/seed-categories.ts",
    "bench": "deno run --allow-net api/scripts/bench.ts",
    "vote-codes": "deno run --allow-env=VOTE_ISSUER_KEY,DEVCON_ISSUER_KEY --allow-read --allow-write=vote-codes scripts/vote-codes.ts",
    "vote-deploy": "deno run --allow-env=VOTE_RELAYER_KEY,DEVCON_RELAYER_KEY,SEPOLIA_RPC_URL,MAINNET_RPC_URL --allow-net --allow-read --allow-write=shared/vote/manifest-data.ts scripts/vote-deploy.ts"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.4",
    "hono": "jsr:@hono/hono@^4.13.14",
    "@std/ulid": "jsr:@std/ulid@^1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11"
  },
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "include": [
      "app/",
      "api/",
      "shared/",
      "server.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "include": [
      "app/",
      "api/",
      "shared/",
      "server.ts",
      "test/"
    ],
    "lineWidth": 100,
    "indentWidth": 2
  }
}
