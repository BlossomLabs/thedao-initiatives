# systemd unit: runs the board under gunicorn, restarts on crash/reboot.
# Install:  sudo cp deploy/thedao-rfps.service /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now thedao-rfps
# Logs:     journalctl -u thedao-rfps -f
#
# Adjust User and the two paths to match where you cloned the repo.
[Unit]
Description=TheDAO Security Fund RFP board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rfps
WorkingDirectory=/home/rfps/thedao-rfps
ExecStart=/home/rfps/thedao-rfps/serve-prod.sh
Restart=always
RestartSec=5
# Small hardening; the app writes only inside its own directory (rfps.db,
# uploads/, .scanner.lock), which ReadWritePaths permits.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/rfps/thedao-rfps

[Install]
WantedBy=multi-user.target
